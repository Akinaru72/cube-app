<div id="cube-loader-vis" role="img" aria-label="Animated 2×2 Rubik's cube loader">
  <div class="view" aria-hidden="true">
    <div class="cube"></div>
  </div>
</div>

<style>
  #cube-loader-vis {
    display: grid;
    min-height: 210px;
    place-items: center;
    perspective: 700px;
  }

  #cube-loader-vis .view {
    width: 112px;
    height: 112px;
    transform-style: preserve-3d;
    transform: rotateX(-28deg) rotateY(38deg);
  }

  #cube-loader-vis .cube,
  #cube-loader-vis .turn-group {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }

  #cube-loader-vis .cubie {
    position: absolute;
    left: 32px;
    top: 32px;
    width: 48px;
    height: 48px;
    transform-style: preserve-3d;
  }

  #cube-loader-vis .sticker {
    position: absolute;
    inset: 2px;
    border-radius: 5px;
    backface-visibility: hidden;
    filter: saturate(1.8) contrast(1.16) brightness(1.12);
  }

  #cube-loader-vis .f { transform: translateZ(24px); background: #e53935; }
  #cube-loader-vis .b { transform: rotateY(180deg) translateZ(24px); background: #ff9800; }
  #cube-loader-vis .r { transform: rotateY(90deg) translateZ(24px); background: #1976d2; }
  #cube-loader-vis .l { transform: rotateY(-90deg) translateZ(24px); background: #43a047; }
  #cube-loader-vis .u { transform: rotateX(90deg) translateZ(24px); background: #fdd835; }
  #cube-loader-vis .d { transform: rotateX(-90deg) translateZ(24px); background: #fafafa; }

  #cube-loader-vis .turn-group {
    transition: transform 480ms cubic-bezier(.38, 0, .22, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    #cube-loader-vis .turn-group { transition: none; }
  }
</style>

<script>
  (() => {
    const root = document.getElementById('cube-loader-vis');
    const cube = root.querySelector('.cube');
    const cubies = [];

    for (const x of [-1, 1]) {
      for (const y of [-1, 1]) {
        for (const z of [-1, 1]) {
          const el = document.createElement('div');
          el.className = 'cubie';

          const exposed = [
            z === 1 ? 'f' : 'b',
            x === 1 ? 'r' : 'l',
            y === -1 ? 'u' : 'd'
          ];

          el.innerHTML = exposed
            .map(face => `<i class="sticker ${face}"></i>`)
            .join('');

          const item = {
            el,
            p: { x, y, z },
            transform: `translate3d(${x * 24}px, ${y * 24}px, ${z * 24}px)`
          };

          el.style.transform = item.transform;
          cube.append(el);
          cubies.push(item);
        }
      }
    }

    const rotatePoint = (p, axis, dir) => {
      const { x, y, z } = p;

      if (axis === 'x') return { x, y: -dir * z, z: dir * y };
      if (axis === 'y') return { x: dir * z, y, z: -dir * x };
      return { x: -dir * y, y: dir * x, z };
    };

    function move() {
      const axis = ['x', 'y', 'z'][Math.floor(Math.random() * 3)];
      const side = Math.random() < 0.5 ? -1 : 1;
      const dir = Math.random() < 0.5 ? -1 : 1;

      const chosen = cubies.filter(item => item.p[axis] === side);

      const group = document.createElement('div');
      group.className = 'turn-group';
      cube.append(group);

      chosen.forEach(item => group.append(item.el));

      requestAnimationFrame(() => {
        group.style.transform = `rotate${axis.toUpperCase()}(${dir * 90}deg)`;
      });

      group.addEventListener('transitionend', () => {
        chosen.forEach(item => {
          item.p = rotatePoint(item.p, axis, dir);
          item.transform = `rotate${axis.toUpperCase()}(${dir * 90}deg) ${item.transform}`;
          item.el.style.transform = item.transform;
          cube.append(item.el);
        });

        group.remove();
      }, { once: true });
    }

    setTimeout(move, 450);
    setInterval(move, 1100);
  })();
</script>